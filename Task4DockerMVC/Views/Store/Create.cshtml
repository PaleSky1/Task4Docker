@model Task4DockerMVC.Models.Store

@{
    ViewData["Title"] = "Create Store";
}

<h2>Add New Store</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Store Name</label>
        <input asp-for="StoreName" class="form-control" />
        <span asp-validation-for="StoreName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Brand ID</label>
        <input asp-for="BrandID" type="number" class="form-control" />
        <span asp-validation-for="BrandID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Energy Drink ID</label>
        <input asp-for="EnergyDrinkID" type="number" class="form-control" />
        <span asp-validation-for="EnergyDrinkID" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Create</button>
</form>
