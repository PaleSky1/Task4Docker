@model IEnumerable<Task4DockerMVC.Models.Store>

@{
    ViewData["Title"] = "Stores List";
}

<h2>Stores</h2>

<a class="btn btn-primary" href="/Store/Create">Add New Store</a>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Store Name</th>
            <th>Brand ID</th>
            <th>Energy Drink ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var store in Model)
        {
            <tr>
                <td>@store.StoreName</td>
                <td>@store.BrandID</td>
                <td>@store.EnergyDrinksID</td>
                <td>
                    <a href="/Store/Edit/@store.StoreID" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/Store/Delete/@store.StoreID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
